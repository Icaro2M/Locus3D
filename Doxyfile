DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Locus3D"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Production code documentation for the Locus3D 3D-printing modeling software"
OUTPUT_DIRECTORY       = docs/generated
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/doxygen/mainpage.md

INPUT                  = docs/doxygen \
                         source
RECURSIVE              = YES
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.hh \
                         *.cpp \
                         *.cxx \
                         *.cc \
                         *.md
EXCLUDE                = extern \
                         out \
                         build \
                         .git \
                         .vs
EXCLUDE_PATTERNS       = */.git/* \
                         */.vs/* \
                         */out/* \
                         */build/* \
                         */extern/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_BY_SCOPE_NAME     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
DISABLE_INDEX          = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           = docs/doxygen-warnings.log

QUIET                  = NO
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

ALIASES                = "ownership=@par Ownership:" \
                         "threading=@par Threading:" \
                         "lifecycle=@par Lifecycle:"
